# Screenshots and headless-browser profiles from local UI checks.
.shots/

# Build output: bytecode, and the file a build stages before swapping it in.
__pycache__/
*.pyc
data/*.building

# A local safety copy of the reference database, kept out of history.
data/rdr2_bkp.db

# The cover art at full size (PNG, a few MB).  The page loads the two
# JPEGs cut from it; this is kept only to cut them again.
images/pixel-cowboy-campfire-at-dusk-cropped.png

# The logo at full size, on its black square.  The icons in images/
# are cut from it as circles; this is kept only to cut them again.
images/wilderness-campfire-emblem.png

# The tab icons as they were drawn (1024px).  images/icons/ holds them
# cut down to 64px, the size of every other icon; these are kept only
# to cut them again.
images/icons/_source/
